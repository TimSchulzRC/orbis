# Optional settings for docker compose. Copy to .env next to docker-compose.yaml and adjust;
# without .env the defaults below apply.

# The image (default latest, the newest main) or an earlier build to go back to, e.g. sha-cfc56ef.
# OBTION_VERSION=latest

# Where the data live on the host. Default: the folder data next to this file.
# Back up this folder; consistent copies of the database are in its subfolder backups.
# OBTION_DATA_DIR=/volume1/docker/obtion-data

# The server runs as the owner of the data folder, never as root. A folder Docker creates goes
# to 1000:1000; set these to give it (and every file in it) to another user and group, e.g. on
# a Synology the user from `id <name>` (often 1026) and the group users (100).
# OBTION_UID=1000
# OBTION_GID=1000

# The port on the host (default 8480).
# OBTION_PORT=8480

# On every address of the host (default) or only on the host itself (127.0.0.1, for a reverse
# proxy or tailscale serve there).
# OBTION_BIND=0.0.0.0

# The server answers under IP addresses and private names (nas, nas.local, *.ts.net) by itself.
# A public name (behind a reverse proxy) has to be named, e.g.
# OBTION_PUBLIC_URL=https://obtion.example.org
# More public names, comma-separated:
# OBTION_ALLOWED_HOSTS=

# off: only sync, API and MCP, no web app.
# OBTION_WEB_APP=on

# Who may create an account. The first account (created on the page) is the admin and always
# allowed. invite (default): only with an invite link from a workspace; open: anyone; off: nobody.
# OBTION_SIGNUP=invite
