# Optional settings for docker compose. Copy to .env next to docker-compose.yaml and adjust;
# without .env the defaults below apply.

# The channel: latest (default, the same as stable), nightly (the newest main at most every six
# hours, for testing with real data), dev (every push to main, test data only). Or a fixed version
# to stay on or go back to, e.g. 0.0.2. Going back from nightly can fail once a newer version has
# converted the data; then restore a backup.
# OBTION_VERSION=latest

# Where the data live on the host. Default: the folder data next to this file.
# Back up this folder; consistent copies of the database are in its subfolder backups.
# OBTION_DATA_DIR=/volume1/docker/obtion-data

# The server runs as the owner of the data folder, never as root. A folder Docker creates goes
# to 1000:1000; set these to give it (and every file in it) to another user and group, e.g. on
# a Synology the user from `id <name>` (often 1026) and the group users (100).
# OBTION_UID=1000
# OBTION_GID=1000

# The port on the host (default 8480).
# OBTION_PORT=8480

# On every address of the host (default) or only on the host itself (127.0.0.1, for a reverse
# proxy or tailscale serve there).
# OBTION_BIND=0.0.0.0

# The server answers under IP addresses and private names (nas, nas.local, *.ts.net) by itself.
# A public name (behind a reverse proxy) has to be named, e.g.
# OBTION_PUBLIC_URL=https://obtion.example.org
# More public names, comma-separated:
# OBTION_ALLOWED_HOSTS=

# off: only sync, API and MCP, no web app.
# OBTION_WEB_APP=on

# Where the built web app is, if not in apps/web/dist (outside Docker: a build of your own).
# OBTION_WEB_DIST=/srv/obtion-web

# Who may create an account. The first account (created on the page) is always allowed.
# invite (default): only with an invite link from a workspace; open: anyone; off: nobody.
# OBTION_SIGNUP=invite

# ---------- Signing in ----------
# The ways to sign in, comma-separated: password, code (6 digits by email), passkey
# (fingerprint, face, device PIN). Default: password,passkey. "password,code" offers both;
# "code" alone: no passwords. "passkey" alone: a new account gives name, email and a passkey,
# no password and no mail server. OAuth providers (below) come on with their own settings.
# Forgot a password? `docker compose exec obtion bun apps/server/src/cli.ts set-password <email>`
# sets a new one (it asks for it).
# OBTION_LOGIN=password,passkey
#
# code: where codes are on, a new account with a password proves its address by a code first.
# Turning codes on for a server whose people signed up with passwords before: the first code of
# such an account proves its address; then its password, other sign-ins, passkeys, agent tokens
# and invite links go (someone else may have signed up with that address). If you know the
# accounts are those people's, run this once before:
#   docker compose exec obtion bun apps/server/src/cli.ts trust-emails
#
# passkey: needs OBTION_PUBLIC_URL with https (or http://localhost). Passkeys belong to its host
# name: opened under another name (an IP address, nas.local) the app offers none. Create an account
# with one, or add one in Settings → Account. With codes on, a new account proves its address by a
# code first and then adds the passkey. The last passkey of an account that has no other way in
# cannot be removed. All passkeys lost with OBTION_LOGIN=passkey: set password,passkey for a
# moment, set-password (above), sign in, add a passkey, switch back.

# Sending mail (for codes): an SMTP server, e.g. smtps://user:password@smtp.example.org:465 or
# smtp://user:password@mail.example.org:587. "log" writes the mails into the server's log instead
# (docker compose logs obtion), for testing. Setting it switches nothing on (see OBTION_LOGIN).
# OBTION_SMTP_URL=
# The sender; default: Obtion <obtion@your public host>
# OBTION_MAIL_FROM=Obtion <obtion@example.org>

# OAuth: also needs OBTION_PUBLIC_URL. Any OpenID Connect provider (Authentik, Authelia,
# Keycloak, Pocket ID, Zitadel, Microsoft Entra, …): the issuer (or its
# /.well-known/openid-configuration), the client, and the button's name.
# Redirect URI at the provider: <OBTION_PUBLIC_URL>/api/auth/callback/oidc
# OBTION_OIDC_ISSUER=https://auth.example.org/application/o/obtion/
# OBTION_OIDC_CLIENT_ID=
# OBTION_OIDC_CLIENT_SECRET=
# OBTION_OIDC_NAME=Authentik
# GitHub (an OAuth app; callback <OBTION_PUBLIC_URL>/api/auth/callback/github):
# OBTION_GITHUB_CLIENT_ID=
# OBTION_GITHUB_CLIENT_SECRET=
# Google (an OAuth client; redirect URI <OBTION_PUBLIC_URL>/api/auth/callback/google):
# OBTION_GOOGLE_CLIENT_ID=
# OBTION_GOOGLE_CLIENT_SECRET=
# Whoever signs in this way for the first time gets an account by the rules of OBTION_SIGNUP;
# an address the provider confirms is joined to the account that has it already.
