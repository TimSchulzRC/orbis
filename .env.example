# Settings for docker compose. Copy to .env next to docker-compose.yml and adjust.

# The address you open in the browser (required). The server only answers under its known
# addresses, e.g. https://nas.example.ts.net (tailscale serve) or https://obtion.example.org
# (reverse proxy). With a port other than 443 include it: https://nas.example.ts.net:8443
OBTION_PUBLIC_URL=https://nas.example.ts.net

# Where the data live on the host. Default: the folder data next to this file.
# Back up this folder; consistent copies of the database are in its subfolder backups.
# OBTION_DATA_DIR=/volume1/docker/obtion-data

# The port on the host (default 8480).
# OBTION_PORT=8480

# Only on the host itself (default) or in the whole network (0.0.0.0). The server has no login
# yet: with 0.0.0.0 everyone in the network can read and change everything.
# OBTION_BIND=127.0.0.1

# More addresses the server answers under, comma-separated, e.g. nas.local:8480
# OBTION_ALLOWED_HOSTS=

# off: only sync, API and MCP, no web app.
# OBTION_WEB_APP=on
