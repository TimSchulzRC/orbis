{
  "name": "Ablage",
  "ignore": [".git/", ".gitkeep", ".gitignore", ".gitattributes"],
  "readme_as_body": true,
  "rewrite_links": true,
  "rules_file": "CLAUDE.md",
  "rules_title": "Regeln für Agenten",
  "history": { "updates": true, "notes": ["*", "*/*"], "refs": ["--branches", "--tags"] },
  "bundle": true,
  "lfs": true,
  "concurrency": 4,
  "rules": [
    { "path": "04_Customer_Projects/Germany_*", "match": "^Germany_(.+)$", "title": "{1}", "type": "Projekt", "parent": "Deutschland" },
    { "path": "04_Customer_Projects/*", "match": "^([A-Za-z]+)_(.+)$", "title": "{2} ({1})", "type": "Projekt" },
    { "path": "02_Countries/*", "match": "^\\d+_(.+)$", "title": "{1}" },
    { "path": "_tools", "pin": true }
  ]
}
