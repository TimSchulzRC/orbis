{
  "name": "obtion",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": ["packages/*", "apps/*"],
  "devDependencies": {
    "@obtion/core": "workspace:*",
    "@obtion/hub": "workspace:*",
    "@types/bun": "^1.4.4",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "yjs": "^13.6.33"
  },
  "scripts": {
    "dev": "bun --watch apps/hub/src/index.ts & bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "dev:build": "bun run --cwd apps/web dev:build",
    "start": "bun apps/hub/src/index.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/sync && tsc --noEmit -p packages/ui && tsc --noEmit -p apps/hub && tsc --noEmit -p apps/web && tsc --noEmit -p .",
    "test": "bun test",
    "test:e2e": "bun run build && bun scripts/e2e.ts",
    "setup": "bun apps/hub/src/cli.ts setup",
    "stats": "bun apps/hub/src/cli.ts stats",
    "import:obsidian": "bun apps/hub/src/cli.ts import-obsidian",
    "import:notion": "bun apps/hub/src/cli.ts import-notion seed/notion.json",
    "seed:demo": "bun scripts/demo-seed.ts",
    "icons": "bun scripts/icons.ts"
  }
}
