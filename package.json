{
	"name": "obtion",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --cwd apps/web build",
		"check": "bash scripts/check",
		"desktop": "bun run --cwd apps/desktop build && bun run --cwd apps/desktop start",
		"desktop:dist": "bun run --cwd apps/desktop dist",
		"dev": "bun --watch apps/server/src/index.ts & bun run --cwd apps/web dev",
		"dev:build": "bun run --cwd apps/web dev:build",
		"dev:reset:all": "bash scripts/obtion-dev reset-all",
		"dev:start": "bash scripts/obtion-dev start",
		"dev:stop": "bash scripts/obtion-dev stop",
		"dev:stop:all": "bash scripts/obtion-dev stop-all",
		"fix": "biome check --write",
		"lint": "biome check",
		"start": "bun apps/server/src/index.ts",
		"start:headless": "OBTION_WEB_APP=off bun apps/server/src/index.ts",
		"test": "bun test",
		"test:browser": "vitest run",
		"test:e2e": "bun run build && bun tests/e2e/smoke.ts",
		"test:e2e:desktop": "bun run --cwd apps/desktop build && bun tests/e2e/desktop.ts",
		"test:integration": "bun test tests/integration",
		"test:unit": "bun test tests/unit",
		"typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/sync && tsc --noEmit -p packages/ui && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop && tsc --noEmit -p ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@obtion/core": "workspace:*",
		"@obtion/server": "workspace:*",
		"@obtion/sync": "workspace:*",
		"@obtion/ui": "workspace:*",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/browser-playwright": "^5.1.0",
		"playwright": "^1.65.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"vitest-browser-react": "^2.3.0",
		"yjs": "^13.6.33"
	}
}
