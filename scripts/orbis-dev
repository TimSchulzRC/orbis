#!/usr/bin/env bash
set -euo pipefail

[[ $# == 1 && ( $1 == start || $1 == stop || $1 == stop-all || $1 == reset-all ) ]] || {
  echo 'Usage: bun run dev:start | bun run dev:stop | bun run dev:stop:all | bun run dev:reset:all' >&2
  exit 1
}
root=$(git rev-parse --show-toplevel)
root=$(cd "$root" && pwd -P)
[[ -f "$root/apps/server/src/index.ts" ]] || { echo 'Not an Orbis worktree' >&2; exit 1; }
key=$(printf '%s' "$root" | sha256sum)
key=${key:0:16}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/orbis-dev
mkdir -p "$state_dir"
exec 9>"$state_dir/lock"
flock 9
state_file=$state_dir/$key.ports
backend_unit=orbis-dev-$key-backend.service
web_unit=orbis-dev-$key-web.service
bun=$(command -v bun || true)
[[ -n $bun ]] || bun=$HOME/.bun/bin/bun
[[ -x $bun ]] || { echo 'Bun is required' >&2; exit 1; }

active() { systemctl --user is-active --quiet "$1"; }
proxy_matches() {
  tailscale serve status --json | "$bun" -e '
    const config = await Bun.stdin.json();
    const [host, port, web] = process.argv.slice(1);
    const proxy = config.Web?.[`${host}:${port}`]?.Handlers?.["/"]?.Proxy;
    process.exit(proxy === `http://127.0.0.1:${web}` ? 0 : 1);
  ' "$host" "$public" "$web"
}
stop() {
  systemctl --user stop "$backend_unit" "$web_unit" 2>/dev/null || true
  if active "$backend_unit" || active "$web_unit"; then
    echo 'Could not stop development services' >&2
    return 1
  fi
  if [[ -n ${public:-} ]] && proxy_matches; then
    tailscale serve --yes --https="$public" off
  fi
}

# Sign in the test account (created on first start) and write a page that hands its token to the app.
login_page=$root/apps/web/node_modules/.orbis-dev/login.html
login() {
  "$bun" -e '
    const [port, page] = process.argv.slice(1);
    const base = `http://127.0.0.1:${port}`;
    const creds = { email: "dev@orbis.test", password: "orbis-dev" };
    const post = (path, body) => fetch(base + path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    let info;
    for (let i = 0; i < 50 && !info; i++) info = await fetch(`${base}/api/info`).then((r) => r.json(), () => Bun.sleep(200));
    if (!info) (console.error("Server not reachable"), process.exit(1));
    const res = info.firstAccount ? await post("/api/account/signup", { name: "Dev", lang: "de", ...creds }) : await post("/api/auth/sign-in/email", creds);
    if (!res.ok) (console.error(`No test account ${creds.email} in this data (${res.status})`), process.exit(1));
    const { token, user } = await res.json();
    const account = JSON.stringify({ token, user: { id: user.id, name: user.name, email: user.email } });
    await Bun.write(page, `<!doctype html><script>localStorage.setItem("orbis.account", ${JSON.stringify(account)}); location.replace("/");</script>`);
    console.log(`Test account: ${creds.email} / ${creds.password}`);
  ' "$backend" "$login_page"
}
signed_in_url() {
  if login; then echo "$url/node_modules/.orbis-dev/login.html"; else echo 'Could not sign in the test account' >&2; echo "$url"; fi
}

# Stop every service managed by this script, including units whose state file is gone.
stop_all() {
  local units unit saved
  units=$(systemctl --user list-units --all --plain --no-legend 'orbis-dev-*-backend.service' 'orbis-dev-*-web.service')
  while read -r unit _; do
    [[ -n $unit ]] || continue
    [[ $unit =~ ^orbis-dev-[a-f0-9]{16}-(backend|web)\.service$ ]] || continue
    systemctl --user stop "$unit"
    if active "$unit"; then
      echo "Could not stop $unit" >&2
      return 1
    fi
  done <<< "$units"
  for saved in "$state_dir"/*.ports; do
    [[ -f $saved ]] || continue
    read -r public web backend host < "$saved"
    [[ $public =~ ^[0-9]+$ && $web =~ ^[0-9]+$ && $backend =~ ^[0-9]+$ && -n $host ]]
    if proxy_matches; then
      tailscale serve --yes --https="$public" off
    fi
  done
}

if [[ $1 == stop-all || $1 == reset-all ]]; then
  # Collect and validate every target before stopping services or deleting data.
  targets=()
  if [[ $1 == reset-all ]]; then
    listing=$(mktemp)
    trap 'rm -f -- "$listing"' EXIT
    git worktree list --porcelain -z > "$listing"
    while IFS= read -r -d "" tree; do
      [[ $tree == "worktree "* ]] || continue
      tree=${tree#worktree }
      [[ -d $tree ]] || continue
      [[ -f "$tree/apps/server/src/index.ts" ]] || continue
      if [[ -L "$tree/data" ]]; then
        echo "Refusing to delete symlink: $tree/data" >&2
        exit 1
      fi
      targets+=("$tree/data")
    done < "$listing"
    rm -f -- "$listing"
    trap - EXIT
  fi
  stop_all
  echo 'Stopped all managed Orbis development servers'
  if [[ $1 == reset-all ]]; then
    for target in "${targets[@]}"; do
      rm -rf -- "$target"
      echo "Deleted: $target"
    done
  fi
  exit
fi

public= web= backend= host=
if [[ -f $state_file ]]; then
  read -r public web backend host < "$state_file"
  [[ $public =~ ^[0-9]+$ && $web =~ ^[0-9]+$ && $backend =~ ^[0-9]+$ && -n $host ]]
fi
if [[ $1 == stop ]]; then
  stop
  echo "Stopped: $root"
  exit
fi
if [[ -n $public ]] && active "$backend_unit" && active "$web_unit" && proxy_matches; then
  url=https://$host:$public
  signed_in_url
  exit
fi
[[ -x "$root/apps/web/node_modules/.bin/vite" ]] || {
  echo 'Run bun install in this worktree first' >&2
  exit 1
}
stop

reserved=' '
for saved in "$state_dir"/*.ports; do
  [[ -f $saved && $saved != "$state_file" ]] || continue
  read -r p w b _ < "$saved"
  reserved+="$p $w $b "
done
free_port() { [[ -z $(ss -H -ltn "sport = :$1") ]]; }
allocate() {
  local name=$1 first=$2 previous=${!1} candidate
  for candidate in ${previous:+$previous} $(seq "$first" "$((first + 499))"); do
    if [[ $reserved != *" $candidate "* ]] && free_port "$candidate"; then
      printf -v "$name" '%s' "$candidate"
      reserved+="$candidate "
      return
    fi
  done
  echo "No free $name port" >&2
  return 1
}
allocate public 18443
allocate web 19000
allocate backend 20000
host=$(tailscale status --json | "$bun" -e 'console.log((await Bun.stdin.json()).Self.DNSName.replace(/\.$/, ""))')
url=https://$host:$public
printf '%s %s %s %s\n' "$public" "$web" "$backend" "$host" > "$state_file"
# Roll back a partial start, including when interrupted.
trap 'stop' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
service() {
  local unit=$1
  shift
  systemd-run --user --collect --service-type=exec --unit="$unit" \
    --working-directory="$root" --property=Restart=on-failure \
    --property=RestartSec=2 --property=TimeoutStopSec=10 \
    --setenv="PATH=$(dirname "$bun"):$PATH" --setenv="PORT=$backend" \
    --setenv="ORBIS_DEV_PUBLIC_URL=$url" --setenv="ORBIS_DATA=$root/data" "$@"
}
service "$backend_unit" "$bun" --watch apps/server/src/index.ts
service "$web_unit" "$bun" run --cwd apps/web dev --port "$web" --strictPort
ready=false
for ((attempt=0; attempt<100; attempt++)); do
  if ! free_port "$web" && ! free_port "$backend" && active "$backend_unit" && active "$web_unit"; then
    ready=true
    break
  fi
  sleep 0.1
done
if [[ $ready != true ]]; then
  echo "Servers did not start. Logs: journalctl --user -u $backend_unit -u $web_unit" >&2
  exit 1
fi
tailscale serve --bg --yes --https="$public" "http://127.0.0.1:$web"
trap - EXIT INT TERM HUP
echo "Running in background: $root"
signed_in_url
